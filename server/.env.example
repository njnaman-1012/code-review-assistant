# ------------------------------------------------------------------
# Code Review Assistant - server configuration
# Copy this file to server/.env and fill in your values.
# NEVER commit the real .env file or share your API keys.
# ------------------------------------------------------------------

# Port the API server listens on
PORT=5000

# Front-end URL(s) allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (created automatically, path relative to server/)
DATABASE_URL=./database/code_review.db

# ================== AI configuration (FREE by default) ==================
# AI_PROVIDER decides which AI services are used, in order:
#   auto  (default) = every FREE provider that can be used, best first:
#                     gemini -> groq -> openrouter (only if their free key is set below)
#                     -> ovh -> llm7 (these two need NO key at all - works out of the box)
#   gemini,llm7     = your own order (comma-separated)
#   anthropic       = paid Claude only (uses AI_API_KEY / AI_MODEL)
#   none            = turn AI off (static analysis only)
AI_PROVIDER=auto

# ---- Free keys (optional, no credit card). Paste any you have; empty = skipped.
# Google Gemini - best free quality.  Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq - very fast.                   Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter - free models.           Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OVHcloud AI Endpoints - works WITHOUT a key (slow, ~2 requests/minute)
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
# LLM7 - works WITHOUT a key; a free token raises the limits: https://token.llm7.io
LLM7_API_KEY=

# ---- Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# OVH_MODEL=Qwen3-Coder-30B-A3B-Instruct
# LLM7_MODEL=codestral-latest

# ---- Paid / custom providers (only used if AI_PROVIDER names them)
# AI_PROVIDER=anthropic   + AI_API_KEY=your Claude key + AI_MODEL=claude-opus-5
# AI_PROVIDER=openai      + AI_API_KEY + AI_MODEL + AI_BASE_URL (any OpenAI-compatible API)
# AI_PROVIDER=ollama      local, free, no key: install Ollama and run "ollama pull qwen2.5-coder:7b"
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---- Tuning
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=32000
# Anthropic only: re-run a safety-declined request on a fallback model (true/false)
AI_REFUSAL_FALLBACK=true

# ================== Limits ==================
MAX_CODE_CHARS=20000
MAX_CODE_LINES=800
RATE_LIMIT_MAX_REVIEWS=20
# "Fix / Correct Code" and "Improve Code" requests allowed per IP per 15 minutes
RATE_LIMIT_MAX_CODE_ACTIONS=20
RATE_LIMIT_MAX_REQUESTS=300

# ================== Deployment ==================
# NODE_ENV=production makes this server also serve the built frontend (npm run build).
# NODE_ENV=production
# Number of proxies in front of the server (1 on Render, Railway, ...).
TRUST_PROXY=0
