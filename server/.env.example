# ------------------------------------------------------------------
# Code Review Assistant - server configuration
# Copy this file to server/.env and fill in your values.
# NEVER commit the real .env file or share your API keys.
# ------------------------------------------------------------------

# Port the API server listens on
PORT=5000

# Front-end URL(s) allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file (created automatically, path relative to server/)
DATABASE_URL=./database/code_review.db
# Hosted Turso database (used on Vercel instead of the local file)
# TURSO_DATABASE_URL=libsql://your-db-your-name.turso.io
# TURSO_AUTH_TOKEN=

# ================== AI configuration (FREE by default) ==================
# AI_PROVIDER decides which AI services are used, in order:
#   auto  (default) = every FREE provider that can be used, best first:
#                     gemini -> groq -> openrouter (only if their free key is set below)
#                     -> ovh -> llm7 (these two need NO key at all - works out of the box)
#   gemini,llm7     = your own order (comma-separated)
#   anthropic       = paid Claude only (uses AI_API_KEY / AI_MODEL)
#   none            = turn AI off (static analysis only)
AI_PROVIDER=auto

# ---- Free keys (optional, no credit card). Paste any you have; empty = skipped.
# Google Gemini - best free quality.  Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq - very fast.                   Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter - free models.           Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OVHcloud AI Endpoints - works WITHOUT a key (slow, ~2 requests/minute)
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
# LLM7 - works WITHOUT a key; a free token raises the limits: https://token.llm7.io
LLM7_API_KEY=

# ---- Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# Other Gemini models tried (same key) when that model is overloaded or rate-limited; "none" = off
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# OVH_MODEL=Qwen3-Coder-30B-A3B-Instruct
# LLM7_MODEL=codestral-latest

# ---- Paid / custom providers (only used if AI_PROVIDER names them)
# AI_PROVIDER=anthropic   + AI_API_KEY=your Claude key + AI_MODEL=claude-opus-5
# AI_PROVIDER=openai      + AI_API_KEY + AI_MODEL + AI_BASE_URL (any OpenAI-compatible API)
# AI_PROVIDER=ollama      local, free, no key: install Ollama and run "ollama pull qwen2.5-coder:7b"
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---- Tuning
AI_TIMEOUT_MS=120000
# Total time the AI may use per review / code action (0 = no limit; 240000 automatically on Vercel)
AI_TIME_BUDGET_MS=0
AI_MAX_OUTPUT_TOKENS=32000
# Anthropic only: re-run a safety-declined request on a fallback model (true/false)
AI_REFUSAL_FALLBACK=true

# ================== E-mail (one-time codes) ==================
# New users must enter a 6-digit code that is e-mailed to them. Without the
# settings below:
#   - on your own computer the code is printed in the server terminal
#   - on a deployed server (Vercel / NODE_ENV=production) registration is closed
#
# EMAIL_PROVIDER: brevo  = Brevo, free 300 e-mails a day, no own domain needed  https://www.brevo.com
#                 resend = Resend, free 100 a day, needs your own verified domain  https://resend.com
#                 console = print the e-mail in the terminal (development only)
EMAIL_PROVIDER=
# API key of the provider (keep it secret, never commit it)
EMAIL_API_KEY=
# Sender address: for Brevo an address you verified in Brevo (Senders), for Resend an address of your domain
EMAIL_FROM=
EMAIL_FROM_NAME=CodeReview AI

# ================== User accounts & security ==================
# Any long random text. It keys the hashes of the one-time codes. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=zawsxedcrfvtgbyhnujmikjnhtgfrdesxwewrectrvytbuynimozexrctvygbuhnijmoklpokmjnhbgvftdrsexxdrcftvgybhunijwbuehdwegvdfwgvbhwnjfnjvdsh
# How long a login stays valid, in hours (default: 7 days)
SESSION_TTL_HOURS=168
# One-time codes: minutes a code is valid, wrong entries allowed per code,
# seconds before another code can be requested, codes per e-mail address per hour
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_HOUR=5
# Wrong passwords for one e-mail address before logging in to it is paused, and for how long
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=150
# Requests per IP address per 15 minutes: register / login / forgot password, and entering / resending codes
LOGIN_RATE_LIMIT=30
OTP_RATE_LIMIT=30
# The cookies are HTTPS-only automatically when NODE_ENV=production or on Vercel.
# COOKIE_SECURE=true
# Web address of the front end if it is served from another origin than the API (comma-separated)
# FRONTEND_URL=https://your-app.vercel.app

# ================== AI tokens ==================
# AI tokens every newly verified user receives (existing users keep their balance).
# To give one user a new allowance:  npm run admin -w server -- tokens user@example.com 100000
DEFAULT_USER_TOKEN_LIMIT=100000
# AI requests (reviews, and Fix/Improve) per user per 15 minutes
AI_RATE_LIMIT=20
# Largest request body the server accepts
MAX_REQUEST_SIZE=200kb

# ================== Limits ==================
MAX_CODE_CHARS=20000
MAX_CODE_LINES=800
# All API requests per IP address per 15 minutes (flood guard)
RATE_LIMIT_MAX_REQUESTS=300
# Optional: separate per-user limits for reviews and for Fix/Improve (default: AI_RATE_LIMIT)
# RATE_LIMIT_MAX_REVIEWS=20
# RATE_LIMIT_MAX_CODE_ACTIONS=20

# ================== Deployment ==================
# NODE_ENV=production makes this server also serve the built frontend (npm run build).
# NODE_ENV=production
# Number of proxies in front of the server (automatically 1 on Vercel).
TRUST_PROXY=0
